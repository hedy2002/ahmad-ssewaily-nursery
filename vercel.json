{
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin/login", "dest": "/admin-login.html" },
    { "src": "/admin/dashboard", "dest": "/admin-dashboard.html" },
    { "src": "/products-manager", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
